# Point to your local 9Router server (default port is 20128)
AI_BASE_URL="http://localhost:20128/v1"

# Target your custom combo string
AI_MODEL="free-combo"

# OpenCode Free is a no-auth provider, so 9Router doesn't strictly validate 
# the API key on local requests, but standard SDKs require a placeholder string.
AI_API_KEY="9router-local-placeholder"
